<Window x:Class="Messenger_Project.EditProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Profile" Height="500" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

        <StackPanel Margin="20">

            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,20">
                <Border Width="100" Height="100" CornerRadius="50" Background="LightGray">
                    <Image Source="/Resources/Profile.png" Stretch="UniformToFill"/>
                </Border>

                <Button Content="Change avatar"
                        Width="120"
                        Margin="0,10,0,0"
                        Click="Change_Avatar_Button_Click"/>
            </StackPanel>


            <TextBlock Text="Username" FontWeight="Bold"/>
            <TextBox x:Name="UsernameBox" Margin="0,5,0,10"/>


            <TextBlock Text="Date of birth" FontWeight="Bold"/>
            <DatePicker x:Name="BirthDatePicker" Margin="0,5,0,10"/>


            <TextBlock Text="Bio" FontWeight="Bold"/>
            <TextBox x:Name="BioBox"
                     Margin="0,5,0,10"
                     Height="80"
                     TextWrapping="Wrap"/>


            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Width="80"
                        Margin="0,0,10,0"
                        Click="Cancel_Button_Click"/>

                <Button Content="Save"
                        Width="80"
                        Click="Save_Button_Click"/>
            </StackPanel>

        </StackPanel>

</Window>