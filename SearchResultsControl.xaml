<UserControl x:Class="Messenger_Project.SearchResultsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="20,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="← Close" Width="80" HorizontalAlignment="Left" 
                        Background="#E0E0E0" Padding="10,5" Cursor="Hand" Click="Close_Click"/>
                <TextBlock Text="Search Results" FontSize="18" FontWeight="Bold" 
                           VerticalAlignment="Center" Margin="20,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Results List -->
        <ListBox Grid.Row="1" x:Name="ResultsListBox" BorderThickness="0" 
                 Background="#FAFAFA" Padding="10">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="White" CornerRadius="8" Padding="12" 
                            Margin="0,0,0,8" BorderBrush="#E0E0E0" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Avatar -->
                            <Border Grid.Column="0" Width="50" Height="50" 
                                    CornerRadius="25" Background="#E8E8E8" VerticalAlignment="Top">
                                <TextBlock Text="?" FontSize="20" HorizontalAlignment="Center" 
                                           VerticalAlignment="Center" Foreground="#999"/>
                            </Border>

                            <!-- User Info -->
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="UsernameBlock" Text="{Binding Username}" 
                                           FontSize="16" FontWeight="Bold" Foreground="#333"/>
                                <TextBlock x:Name="BioBlock" Text="{Binding Bio}" 
                                           FontSize="12" Foreground="#999" 
                                           TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                            </StackPanel>

                            <!-- Buttons -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" 
                                       VerticalAlignment="Center" Margin="10,0,0,0">
                                <Button Content="👤 Profile" Width="90" Height="35" 
                                        Background="#6c757d" Foreground="White" 
                                        Cursor="Hand" Margin="0,0,8,0" Click="ViewProfile_Click"/>
                                <Button Content="💬 Message" Width="90" Height="35" 
                                        Background="#0078D7" Foreground="White" 
                                        Cursor="Hand" Click="SendMessage_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </Grid>
</UserControl>
