<UserControl x:Class="Messenger_Project.ContactsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Search -->
        <Border Grid.Row="0" CornerRadius="8" BorderBrush="#DDD" BorderThickness="1" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Padding="10" FontSize="16" Text="Search contacts..." Foreground="Gray" BorderThickness="0"/>
                <Button Grid.Column="1" Content="Search" Click="Search_Click" Margin="5"/>
            </Grid>
        </Border>

        <!-- Header with count -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,0,0,10">
            <TextBlock Text="Contacts" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock x:Name="CountText" Text="(0)" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#666"/>
        </StackPanel>

        <!-- Empty state -->
        <TextBlock x:Name="EmptyState" Grid.Row="2" Text="No contacts found" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Foreground="#888" Margin="0,10"/>

        <!-- Contacts list -->
        <ListBox x:Name="ContactsListBox" Grid.Row="2" BorderThickness="0" FontSize="18" Margin="0,40,0,0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,5" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="16" Background="#EEE" VerticalAlignment="Center">
                            <Image Source="/Resources/Profile.png" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding Username}" Margin="10,0" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,0,0,0">
                            <Button Content="View" Width="60" Margin="6,0" Click="ViewProfile_Click"/>
                            <Button Content="Chat" Width="60" Margin="6,0" Click="OpenChat_Click"/>
                            <Button Content="Remove" Width="70" Margin="6,0" Click="RemoveContact_Click"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>