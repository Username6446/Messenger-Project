<UserControl x:Class="Messenger_Project.ContactsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Поле пошуку. Завдання: додай йому BorderBrush і заокруглення -->
        <TextBox Grid.Row="0" Padding="10" FontSize="16" Text="Search contacts..." Foreground="Gray" Margin="0,0,0,20"/>

        <!-- Список контактів. Завдання: зміни ItemTemplate, щоб поруч з іменем була маленька картинка -->
        <ListBox Grid.Row="1" BorderThickness="0" FontSize="18">
            <ListBoxItem Content="Andriy" Margin="0,5"/>
            <ListBoxItem Content="Olena" Margin="0,5"/>
            <ListBoxItem Content="Maxym" Margin="0,5"/>
        </ListBox>
    </Grid>
</UserControl>