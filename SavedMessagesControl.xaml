<UserControl x:Class="Messenger_Project.SavedMessagesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource HeaderBackground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="70" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                <Button Content="Back" Width="60" Margin="0,0,20,0" Click="Back_Click"/>
                <TextBlock Text="Saved Messages" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <ListBox x:Name="SavedMessagesList" Grid.Row="1" BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource OutgoingMessage}" CornerRadius="8" Margin="10,5" Padding="12,8">
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14"/>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="2" Background="{DynamicResource MainBackground}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="MessageInput" Grid.Column="0" Margin="15,15,5,15" VerticalContentAlignment="Center" FontSize="14"/>
            <Button Grid.Column="1" Content="Save" Margin="5,15,15,15" Click="SaveMessage_Click" Cursor="Hand"/>
        </Grid>
    </Grid>
</UserControl>