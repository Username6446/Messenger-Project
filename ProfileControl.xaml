<UserControl x:Class="Messenger_Project.ProfileControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <StackPanel Margin="20">

        <Button Content="Back" Width="60" HorizontalAlignment="Left" Margin="0,0,0,20" Click="Back_Click"/>

        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,20">
            <Border Width="100" Height="100" Background="LightGray" CornerRadius="50">
                <TextBlock Text="?" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <TextBlock x:Name="DisplayUsername" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,10"/>
            <Button Content="Edit Profile" Width="100" Click="EditProfile_Click"/>
        </StackPanel>

        <TextBlock Text="Username:" FontWeight="Bold"/>
        <TextBlock x:Name="UsernameText" Margin="0,0,0,15"/>

        <TextBlock Text="Date of birth:" FontWeight="Bold"/>
        <TextBlock x:Name="BirthDateText" Margin="0,0,0,15"/>

        <TextBlock Text="Bio:" FontWeight="Bold"/>
        <TextBlock x:Name="BioText" Margin="0,0,0,15" TextWrapping="Wrap"/>

        <TextBlock Text="Member since:" FontWeight="Bold"/>
        <TextBlock x:Name="MemberSinceText"/>

    </StackPanel>
</UserControl>