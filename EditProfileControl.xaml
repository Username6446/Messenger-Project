<UserControl x:Class="Messenger_Project.EditProfileControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <StackPanel Margin="20">

        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,20">
            <Border Width="100" Height="100" Background="LightGray" CornerRadius="50">
                <Image Source="/Resources/Profile.png" Stretch="UniformToFill"/>
            </Border>
            <Button Content="Change avatar" Width="100" Margin="0,10,0,0" Click="Change_Avatar_Button_Click"/>
        </StackPanel>

        <TextBlock Text="Username:" FontWeight="Bold"/>
        <TextBox x:Name="UsernameBox" Margin="0,0,0,15"/>

        <TextBlock Text="Date of birth:" FontWeight="Bold"/>
        <DatePicker x:Name="BirthDatePicker" Margin="0,0,0,15"/>

        <TextBlock Text="Bio:" FontWeight="Bold"/>
        <TextBox x:Name="BioBox" Height="60" TextWrapping="Wrap" Margin="0,0,0,20"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="80" Margin="0,0,10,0" Click="Cancel_Button_Click"/>
            <Button Content="Save" Width="80" Click="Save_Button_Click"/>
        </StackPanel>

    </StackPanel>
</UserControl>